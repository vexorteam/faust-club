# Copy to .env.local and fill in. Never commit the filled-in file.

# Base URL of the Python API, without a trailing slash.
# The frontend appends the versioned path itself: /api/v1/menu, /api/v1/auth/login.
# Unset in development means the static sample menu from src/data/menu.ts —
# and no admin login at all, since the API is the one that checks credentials.
MENU_API_URL=http://localhost:8000

# Shared secret for POST /api/revalidate. Must be identical in both
# applications — the API sends it as `Authorization: Bearer <secret>`
# after every content change.
REVALIDATE_SECRET=

# Hostname that serves menu and atmosphere photos. Next.js allow-lists
# remote image hosts at build time, so this cannot be resolved per-request.
MEDIA_HOSTNAME=media.faust.bar

# Public origin of the site. Reserved for deployment (step 13);
# canonical URLs currently come from `site.url` in src/data/site.ts.
NEXT_PUBLIC_SITE_URL=https://faust.bar
