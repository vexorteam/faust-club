# Build context: sources and the lock file, nothing else. `.next` and
# node_modules from the working tree would be stale inside the image, and an
# .env.local carries the shared revalidation secret.
node_modules/
.next/
out/
build/

.env
.env.local
.env*.local

coverage/
playwright-report/
test-results/
e2e/

.idea/
.vscode/
*.log
