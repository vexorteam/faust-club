# Copy to .env and fill in — `docker compose` reads it. Never commit the
# filled-in file: it carries the signing key of the admin sessions.
#
# The two applications have their own .env files for running them by hand
# (api/.env.example, faust/.env.example). This one exists only for the
# containers, and compose passes the values into them itself.

# ── Addresses ────────────────────────────────────────────────────────────────
# What the proxy answers to. Locally these are plain http on port 80; with real
# names Caddy asks for certificates by itself, and https here is all it takes.
#   production: SITE_ORIGIN=https://faust.bar  MEDIA_ORIGIN=https://media.faust.bar
SITE_ORIGIN=http://localhost
MEDIA_ORIGIN=http://media.faust.bar

# Host part of MEDIA_ORIGIN. Next allow-lists photo hosts when the image is
# built, so changing it means rebuilding `web`, not just restarting it.
MEDIA_HOSTNAME=media.faust.bar

# Set to 1 only for a stack raised on your own machine: it lets the frontend
# load photos over plain http from a private address. Empty everywhere else.
LOCAL_MEDIA=1

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=faust
POSTGRES_PASSWORD=
POSTGRES_DB=faust

# ── Secrets ──────────────────────────────────────────────────────────────────
# Signs the admin sessions. Exists only in the API; changing it signs everyone
# out. Generate: openssl rand -base64 48
JWT_SECRET=

# Shared by both applications: the API sends it as a bearer token when it tells
# the frontend that the showcase is out of date. Generate the same way.
REVALIDATE_SECRET=

# ── First administrator ──────────────────────────────────────────────────────
# Read by `python -m faust_api.seed` and by nothing else. After the first run
# the password is a hash in the database and these can be emptied; changing it
# later is `python -m faust_api.set_admin_password` (see api/README.md).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Build ────────────────────────────────────────────────────────────────────
# Where the frontend reads the menu from *while its image is being built*. The
# showcase is prerendered, so this has to point at a running, seeded API — on
# the server that is the port compose publishes on the loopback. Leave it empty
# only if you accept a first deploy with an empty menu.
BUILD_MENU_API_URL=http://127.0.0.1:8000

# ── Tuning ───────────────────────────────────────────────────────────────────
# Uvicorn workers. One by default, and raising it has a consequence: the
# sign-in limit counts attempts in the memory of a process, so N workers allow
# up to 5×N guesses per ten minutes.
API_WORKERS=1

# Whose X-Forwarded-For the API believes. Defaults to the compose network, so
# the sign-in limit counts the visitor rather than the web container.
TRUSTED_PROXIES=172.28.0.0/16
