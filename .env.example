# Copy to .env and fill in. Never commit the filled-in file.

# false -> development (HTTP)
# true  -> production (HTTPS)
SESSION_SECURE=false

# SITE_ORIGIN=https://faust.bar
# MEDIA_ORIGIN=https://media.faust.bar
SITE_ORIGIN=http://localhost
MEDIA_ORIGIN=http://media.faust.bar

# Host part of MEDIA_ORIGIN. Changing it requires rebuilding `web`.
MEDIA_HOSTNAME=media.faust.bar

# Set to 1 only for local development with plain HTTP media.
LOCAL_MEDIA=1

POSTGRES_USER=faust
POSTGRES_PASSWORD=
POSTGRES_DB=faust

# Signs admin sessions. Changing it signs everyone out.
# Generate: openssl rand -base64 48
JWT_SECRET=

# Shared by the API and frontend for revalidation requests.
# Generate: openssl rand -base64 48
REVALIDATE_SECRET=

# Used by `python -m faust_api.seed`.
# After the first run, credentials are stored as a hash in the database.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# The API must be running and seeded when the frontend image is built.
BUILD_MENU_API_URL=http://127.0.0.1:8000

# Uvicorn workers.
# The sign-in rate limit is per process, so N workers allow up to 5×N attempts
# per ten minutes.
API_WORKERS=1

# Proxy network trusted for X-Forwarded-For.
TRUSTED_PROXIES=172.28.0.0/16