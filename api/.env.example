# Copy to .env and fill in. Never commit the filled-in file.
# A missing required variable stops the application at startup with a message
# naming it — it does not wait for the first request to fail.

# development | production. In production the OpenAPI schema and /docs are off.
ENVIRONMENT=development

# Async driver in the URL is required: SQLAlchemy talks to Postgres over asyncpg.
DATABASE_URL=postgresql+asyncpg://faust:faust@localhost:5432/faust

# Signing key of the session tokens (§5.4). Exists only here — the frontend
# never verifies a token itself, it only carries it in an httpOnly cookie.
JWT_SECRET=

# How long a token lives. Seven days: the owner signs in about once a week.
JWT_TTL_DAYS=7

# Prefix every photo URL is built from, without a trailing slash.
# Production: https://media.faust.bar · locally: http://localhost:8000/media
MEDIA_BASE_URL=http://localhost:8000/media

# Where uploaded photos live. In production this is a Docker volume —
# losing it means losing every photo of the menu and the atmosphere.
UPLOAD_DIR=./uploads

# Addresses or CIDRs whose X-Forwarded-For header may be believed, comma
# separated. Empty means nobody, and the login limit then counts the peer that
# opened the connection. The login form is proxied through Next, so behind it
# every visitor shares one peer — name the web container's network here.
TRUSTED_PROXIES=

# Where to knock after every content change so the showcase refreshes (§5.3).
# Without it the site only catches up on the ISR timer.
REVALIDATE_URL=http://localhost:3000/api/revalidate

# Must be identical to REVALIDATE_SECRET in faust/.env.local
REVALIDATE_SECRET=

# Read by the seed script only, never by the application. The password is
# hashed on first run; keep it out of the shell history.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
